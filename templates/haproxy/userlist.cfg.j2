{# Userlists defined by the user, plus the one dataplaneapi authenticates against (unless the user already defines it) #}
{% set _userlists = haproxy_userlists %}
{% if haproxy_dataplaneapi_enabled and (haproxy_userlists | selectattr('name', 'equalto', _dataplaneapi_haproxy_userlist) | list | length == 0) %}
{% set _userlists = _userlists + [{'name': _dataplaneapi_haproxy_userlist, 'users': [{'name': _dataplaneapi_haproxy_user, 'insecure_password': _dataplaneapi_haproxy_password}]}] %}
{% endif %}
{% for userlist in _userlists %}
userlist {{ userlist.name }}
{% for user in userlist.users %}
{% set _user_groups = (' groups ' ~ (user.groups | join(','))) if user.groups is defined else '' %}
{% if user.password is defined %}
  user {{ user.name }} password {{ user.password }}{{ _user_groups }}
{% elif user.insecure_password is defined %}
  user {{ user.name }} insecure-password {{ user.insecure_password }}{{ _user_groups }}
{% endif %}
{% endfor %}
{% endfor %}